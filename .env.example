# ---------------------------------------------------------------------------
# KofClub local environment. Copy to .env (scripts/init-env.sh does this and
# generates the secrets below). NEVER use .env files in production: production
# secrets come from a managed secret store (see docs/security.md).
# ---------------------------------------------------------------------------

# local | test | development | staging | production
APP_ENV=local
LOG_LEVEL=info

# --- PostgreSQL (source of truth) ---
POSTGRES_USER=kofclub
POSTGRES_PASSWORD=kofclub_local_only
POSTGRES_DB=kofclub
POSTGRES_PORT=5432
DATABASE_URL=postgres://kofclub:kofclub_local_only@localhost:5432/kofclub?sslmode=disable

# --- Redis (ephemeral: presence, rate limits, revocation cache) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Control API (NestJS) ---
CONTROL_API_PORT=4000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Proxies allowed to set X-Forwarded-For: hop count (e.g. 1 behind one load
# balancer) or addresses/CIDRs. Wrong values break per-IP rate limiting.
TRUST_PROXY=loopback
# Ed25519 key pair (PKCS8 / SPKI PEM, base64-encoded) used to sign access tokens.
# Generated by scripts/init-env.sh.
AUTH_JWT_PRIVATE_KEY_B64=
AUTH_JWT_PUBLIC_KEY_B64=
AUTH_JWT_ISSUER=kofclub-control-api
AUTH_JWT_AUDIENCE=kofclub
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Shared secret for service-to-service calls (control-api <-> game-service,
# realtime-gateway <-> game-service). Generated by scripts/init-env.sh.
INTERNAL_SERVICE_TOKEN=
# Pepper used to hash IP addresses before storing them (privacy).
IP_HASH_SECRET=
# 32 random bytes, base64. Encrypts TOTP (two-factor) secrets at rest.
MFA_ENCRYPTION_KEY_B64=
# Platform-admin routes need a two-factor session (ADR-017); false only for
# local demos (refused in production).
ADMIN_MFA_REQUIRED=true

# --- Game service (Go) ---
GAME_SERVICE_PORT=4200
GAME_SERVICE_URL=http://localhost:4200
GAME_NODE_ID=game-local-1
# 32 random bytes, base64. Encrypts persisted decks/hole cards at rest (key id 1).
DECK_ENCRYPTION_KEY_B64=
# Key rotation instead of the line above: "id:base64,id:base64", first key
# active (docs/runbooks/deck-key-rotation.md).
# DECK_ENCRYPTION_KEYS=

# --- Realtime gateway (Go) ---
REALTIME_PORT=4100
# control-api base URL for internal authorization checks (service token).
CONTROL_API_INTERNAL_URL=http://localhost:4000

# --- Worker ---
WORKER_PORT=4300

# --- Tracing (optional) ---
# OTLP/HTTP endpoint for OpenTelemetry traces. Empty = no export (W3C trace
# context is still propagated). With `make observability` and services run
# natively: http://localhost:4318. For services inside Docker Compose set
# COMPOSE_OTEL_ENDPOINT=http://jaeger:4318 instead.
OTEL_EXPORTER_OTLP_ENDPOINT=
COMPOSE_OTEL_ENDPOINT=

# --- Web client (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4100/ws
