{
  "name": "@kofclub/control-api",
  "version": "0.1.0",
  "private": true,
  "description": "Control-plane HTTP API (NestJS): identity, clubs, RBAC, table config, ledger admin, history.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "seed": "node -r @swc-node/register src/seed/run-seed.ts"
  },
  "dependencies": {
    "@kofclub/contracts": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "ioredis": "^5.8.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@kofclub/config": "workspace:*",
    "@nestjs/testing": "^11.1.0",
    "@swc-node/register": "^1.11.0",
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.4",
    "typescript": "5.9.3"
  }
}
