{
  "name": "@kofclub/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical OpenAPI/JSON-Schema contracts and generated TypeScript types.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "lint:openapi": "redocly lint openapi/control-api.yaml openapi/realtime.yaml --config redocly.yaml",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@kofclub/config": "workspace:*",
    "@redocly/cli": "^2.10.0",
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "jest": "^30.2.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "yaml": "^2.8.0"
  }
}
